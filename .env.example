# Railway: Postgres 서비스를 추가하고 앱 서비스 Variables 에 아래 값을 넣습니다.
DATABASE_URL=postgres://postgres@localhost:5432/lift   # Railway 에서는 ${{Postgres.DATABASE_URL}} 로 참조
TEACHER_PASSWORD=change-me                              # 강사 비밀번호 (필수)
CLASS_CODE=LIFT38                                       # 처음 만들 수업 코드 (선택, 이후 강사 화면에서 변경)
# SESSION_SECRET=                                       # 강사 세션 서명 키 (선택, 없으면 비밀번호에서 파생)
# PGSSL=true                                            # DB 에 공개 주소(proxy)로 붙을 때만
PORT=3000
